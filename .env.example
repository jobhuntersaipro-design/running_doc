# Admin login (/admin). Make the hash with: node scripts/hash-password.mjs
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Any long random string, e.g. from: openssl rand -base64 32
AUTH_SECRET=

# Google sign-in for runners. Google Cloud console > APIs & Services > Credentials >
# OAuth client ID (Web application). Authorized redirect URI: <site>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 for race files and covers. Leave empty to use the local .data folder.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket: the r2.dev address or a custom domain, no trailing slash
R2_PUBLIC_URL=
# Only for buckets in a jurisdiction, e.g. https://<account id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
